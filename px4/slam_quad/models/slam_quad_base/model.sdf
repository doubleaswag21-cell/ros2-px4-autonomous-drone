<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='slam_quad_base'>
    <pose>0 0 .24 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <inertial>
        <!-- Approximate M3B-2 frame mass model: 1.80 kg base structure. -->
        <!-- The four rotor links keep their existing masses separately. -->
        <pose>0 0 -0.0034 0 0 0</pose>
        <mass>1.8</mass>
        <inertia>
          <ixx>0.01808</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01798</iyy>
          <iyz>0</iyz>
          <izz>0.01886</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay />
      <!-- =============================== -->
      <!-- CUSTOM SLAM QUAD BODY           -->
      <!-- =============================== -->

      <visual name="custom_body_visual">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.16 0.07</size>
          </box>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Front-left arm -->
      <visual name="arm_fl_visual">
        <pose>0.100 0.100 0.02 0 0 0.785398</pose>
        <geometry>
          <box>
            <size>0.282843 0.025 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>

      <!-- Rear-left arm -->
